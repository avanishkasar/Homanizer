{
  "name": "@naturalwrite/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "dev": "dotenv -e ../../.env -- next dev",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- prisma generate && vitest run && python -m unittest discover -s python -p test_*.py",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev"
  },
  "dependencies": {
    "@naturalwrite/ai": "workspace:*",
    "@naturalwrite/shared": "workspace:*",
    "@prisma/client": "^6.8.2",
    "@xmldom/xmldom": "^0.9.8",
    "dotenv-cli": "^8.0.0",
    "fflate": "^0.8.3",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "prisma": "^6.8.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
